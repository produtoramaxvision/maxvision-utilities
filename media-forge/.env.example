# Auth
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Workspace
MEDIA_FORGE_OUTPUT_DIR=./outputs
MEDIA_FORGE_PROJECT_DIR=./.media-forge

# Behavior
MEDIA_FORGE_LOG_LEVEL=info
MEDIA_FORGE_LOG_FORMAT=json
MEDIA_FORGE_DRY_RUN=false
MEDIA_FORGE_POLL_INTERVAL_MS=10000
MEDIA_FORGE_POLL_MAX_ATTEMPTS=90
MEDIA_FORGE_RUN_LIVE_TESTS=false
MEDIA_FORGE_RUN_EVALS=false

# Cost guard (C4 fix: retry budget visible)
MEDIA_FORGE_DAILY_CAP_USD=25
MEDIA_FORGE_CONFIRM_THRESHOLD_USD=0.50
MEDIA_FORGE_BLOCK_THRESHOLD_USD=2.00
MEDIA_FORGE_RETRY_BUDGET_MULTIPLIER=3
MEDIA_FORGE_SHOW_RETRY_BUDGET=true

# T14 — retake reserve. Holds back a slice of the daily cap so the reviewer can
# still afford to fix takes after a day of first-attempt generations.
# MODE defaults to 'observe' (inert, pre-T14 behaviour). Set to 'cap' to enforce.
#   observe = record only  |  warn = allow and warn  |  cap = block new work
MEDIA_FORGE_BUDGET_RESERVE_PCT=0.10
MEDIA_FORGE_BUDGET_RESERVE_MODE=observe

# Higgsfield, HTTP API. The auth scheme is two custom headers, not Bearer:
# `hf-api-key` and `hf-secret`, taken from these two variables
# (src/video/providers/auth/higgsfield-headers.ts).
#
# HIGGSFIELD_API_KEY is NOT this credential. It appears only as server.ts's
# "is Higgsfield configured?" boot heuristic; setting it alone gets you past boot
# and then `Missing required environment variable(s): HF_API_KEY, HF_API_SECRET`
# on the first call.
# HF_API_KEY=
# HF_API_SECRET=

# REQUIRED whenever HF_API_KEY is set — the server calls process.exit(2) at boot
# without it. Higgsfield prices in credits, and every USD figure in the router,
# the daily cap and the ledger comes from this rate.
# Published tiers: Plus 0.039 ($39/1000) | Ultra 0.0316 ($79/2500) | Business 0.0266.
# Accepted range [0.001, 1.0]. If your plan is not one of those, the rate is what
# you pay divided by the credits granted — `higgsfield account status --json` and
# `higgsfield account transactions --json` report both.
# MEDIA_FORGE_HIGGSFIELD_USD_PER_CREDIT=0.039

# Speak / Speak 2.0 audio reference. 'URL' (default) passes the caller's audio
# path through as a publicly fetchable URL; 'SIGNED_UPLOAD' requires
# HiggsfieldProvider.uploadAudio(), which is not implemented and throws.
# See the open P1 in TODOS.md: the documented Speak contract lives on the v2 API
# surface and is not what this code sends.
# MEDIA_FORGE_HF_SPEAK_AUDIO_MODE=URL

# Settle Higgsfield jobs from webhook callbacks instead of polling.
# MEDIA_FORGE_HF_WEBHOOK_ENABLE=false

# Windows: npm/pnpm install CLIs as shims that Node cannot spawn without a shell.
# Point these at a real executable when `higgsfield`/`codex` fail with ENOENT or
# EINVAL.
# MEDIA_FORGE_HF_BIN=
# MEDIA_FORGE_CODEX_BIN=

# T5 — Higgsfield via the official CLI instead of the HTTP API. Bills the
# logged-in user's workspace rather than API credits, so it needs `higgsfield
# auth login` on this machine. Only the exact string 'true' enables it, and it
# must stay off in multi-tenant hosting: one OAuth session cannot serve tenants.
MEDIA_FORGE_HF_CLI_ENABLED=false

# T16 — Wan2GP, self-hosted. media-forge NEVER installs it or downloads weights.
# Run `media-forge setup wan2gp` for the requirements first (6 GB VRAM, 30-80 GB
# disk). Prices at $0, so it is excluded from automatic routing and must be
# selected with preferProvider.
MEDIA_FORGE_WAN2GP_ENABLED=false
# MEDIA_FORGE_WAN2GP_URL=http://127.0.0.1:7860

# PR7 — MuAPI (aggregator). Catalogue and prices come from its own API at
# runtime; there is deliberately no local rate table.
# MUAPI_API_KEY=

# T17 — Codex image generation. TWO credential paths:
#   builtin  the built-in image_gen tool via `codex login` OAuth on this machine.
#            No OPENAI_API_KEY, no per-image charge beyond your ChatGPT plan.
#   cli      scripts/image_gen.py against the OpenAI Images API. Metered.
# Mode is auto-detected: OPENAI_API_KEY present -> cli, otherwise builtin.
# Override with MEDIA_FORGE_CODEX_IMAGE_MODE=builtin|cli.
MEDIA_FORGE_CODEX_IMAGE_ENABLED=true
# Required ONLY in cli mode. There is no default: this repo has no verified
# OpenAI image rate, and a guessed one would enter the ledger looking real.
# MEDIA_FORGE_CODEX_IMAGE_USD_PER_IMAGE=

# Review
MEDIA_FORGE_OCR=cloud-vision
MEDIA_FORGE_OCR_GOOGLE_VISION_KEY=
MEDIA_FORGE_REVIEW_THRESHOLD=7.5
MEDIA_FORGE_MAX_FIX_ATTEMPTS=3
MEDIA_FORGE_SKIP_OCR_WHEN_NO_TEXT_INTENT=true

# Region
MEDIA_FORGE_REGION=

# ---------------------------------------------------------------------------
# MinIO refs bucket (Phase 1+)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=https://s3.meuagente.api.br
MINIO_REGION=us-east-1
MINIO_BUCKET=media-forge-refs
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true

# ---------------------------------------------------------------------------
# Semantic search (Phase 2 only)
# ---------------------------------------------------------------------------
VOYAGE_API_KEY=
PGVECTOR_URL=postgresql://user:pass@host:5432/dbname

# ---------------------------------------------------------------------------
# Refs runtime toggles
# ---------------------------------------------------------------------------
MEDIA_FORGE_REFS_ENABLED=true
MEDIA_FORGE_REF_MATCH_ENABLED=false
MEDIA_FORGE_REF_MATCH_THRESHOLD=0.65

# ---------------------------------------------------------------------------
# Marengo 3.0 via AWS Bedrock (Phase 2.8 alternative embedding backend)
# ---------------------------------------------------------------------------
MEDIA_FORGE_EMBED_BACKEND=voyage   # or "marengo" to swap
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MARENGO_MODEL_ID=twelvelabs.marengo-embed-3-0-v1:0

# ---------------------------------------------------------------------------
# Kling — video generation (api-singapore.klingai.com)
# ---------------------------------------------------------------------------
# Preferred. Static API key, sent as `Authorization: Bearer <key>`. Works for
# ALL models. Create it at https://klingai.com -> Console -> "+ New API Key";
# the value is shown once. When this is set, the AccessKey/SecretKey pair below
# is ignored entirely.
KLING_API_KEY=
# Legacy. AccessKey/SecretKey signed into an HS256 JWT per request. Kling calls
# this the "legacy version design standards" scheme and scopes it to models 3.0
# and earlier. Only used when KLING_API_KEY is empty.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Optional. JWT cache TTL in seconds for the legacy path. Default 1500 (25min),
# capped at 1800 to stay inside Kling's 30-minute token window.
KLING_JWT_CACHE_TTL_SEC=

# ---------------------------------------------------------------------------
# Seedance 2.0 — ByteDance video model via fal.ai + BytePlus ARK fallback (P16)
# ---------------------------------------------------------------------------
# Primary: fal.ai USD billing, no China KYC. Get key at https://fal.ai/dashboard/keys
FAL_KEY=
# Fallback: BytePlus ModelArk REST, activates when fal.ai returns 5xx.
# Get key at https://console.byteplus.com/auth/api-key
BYTEPLUS_ARK_API_KEY=
# Emergency kill switch — set false to disable all Seedance tools without code changes.
MEDIA_FORGE_SEEDANCE_ENABLED=true

# ---------------------------------------------------------------------------
# ffmpeg (LGPL/system) — used for animated-ref fallback + video first-frame review.
# media-forge does NOT bundle ffmpeg (avoids GPL/x264-x265 patent exposure).
# Provide one of:
#   - ffmpeg on PATH (winget install Gyan.FFmpeg | brew install ffmpeg | apt-get install ffmpeg)
#   - MEDIA_FORGE_FFMPEG_PATH=/absolute/path/to/ffmpeg
# ---------------------------------------------------------------------------
# MEDIA_FORGE_FFMPEG_PATH=
